{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "outDir": "dist",
    "declarationDir": "dist",
    "declaration": true,
    "declarationMap": true,
    // keep the incremental build cache out of dist so it is not published
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  "include": [
    "./src/**/*"
  ],
  "exclude": [
    "node_modules/**",
    "**/node_modules/**",
    "**/dist/**"
  ]
}
